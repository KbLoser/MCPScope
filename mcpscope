#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")"
mkdir -p data

# Load only the variables owned by this tool. Values are assigned directly;
# this intentionally avoids eval so .env content cannot execute shell code.
if [ -f .env ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ""|"#"*) continue ;;
    esac
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      MCPSCOPE_DATA_DIR|LLM_API_URL|LLM_MODEL|LLM_API_KEY|GITHUB_TOKEN|SMITHERY_API_KEY|CENSYS_API_ID|CENSYS_API_SECRET|FOFA_EMAIL|FOFA_KEY|SHODAN_API_KEY)
        value="${value#\"}"
        value="${value%\"}"
        value="${value#'}"
        value="${value%'}"
        export "$key=$value"
        ;;
    esac
  done < .env
fi

if [ -n "${PYTHON_BIN:-}" ]; then
  PYTHON_CANDIDATES="$PYTHON_BIN"
else
  PYTHON_CANDIDATES="python3.13 python3.12 python3.11 python3"
fi

PYTHON_BIN=""
for candidate in $PYTHON_CANDIDATES; do
  if command -v "$candidate" >/dev/null 2>&1 \
    && "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    PYTHON_BIN="$candidate"
    break
  fi
done
if [ -z "$PYTHON_BIN" ]; then
  printf '%s\n' "Python 3.11+ is required. Set PYTHON_BIN to its executable path if installed." >&2
  exit 127
fi

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  printf '%s\n' "Node.js 20+ and npm are required." >&2
  exit 127
fi
if ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 20 ? 0 : 1)'; then
  printf '%s\n' "Node.js 20+ is required; found $(node --version)." >&2
  exit 1
fi

if [ ! -x .venv/bin/python ]; then
  "$PYTHON_BIN" -m venv .venv
fi
if ! .venv/bin/python -c 'import requests' >/dev/null 2>&1; then
  .venv/bin/python -m pip install --disable-pip-version-check -r requirements.txt
fi
if [ ! -d node/node_modules/@modelcontextprotocol/sdk ]; then
  npm --prefix node ci --omit=dev
fi

exec .venv/bin/python src/mcpscope.py "$@"
